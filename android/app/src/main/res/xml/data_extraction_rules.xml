<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 及以上的备份 / 设备迁移规则（android:dataExtractionRules）。

  与 backup_rules.xml 保持同样的排除范围：只挡凭据，不挡普通配置。
  云备份与设备间传输**都要**排除 —— 只写一处的话，换机迁移那条路径
  仍会把登录凭据带过去。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="vdl_cookies.xml" />
        <exclude domain="sharedpref" path="vdl_jm_session.xml" />
        <exclude domain="sharedpref" path="vdl_net.xml" />
        <exclude domain="root" path="app_webview" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="vdl_cookies.xml" />
        <exclude domain="sharedpref" path="vdl_jm_session.xml" />
        <exclude domain="sharedpref" path="vdl_net.xml" />
        <exclude domain="root" path="app_webview" />
    </device-transfer>
</data-extraction-rules>
